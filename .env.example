# Web JS API key (public identifier; restrict its domain in the AMap console)
AMAP_JS_KEY=
# JS security code: server-side only
AMAP_JS_SECURITY_CODE=
# Separate Web Service API key: server-side only
AMAP_WEB_SERVICE_KEY=
PORT=8787

# Private credential for isolated QA writes only; never VITE_ or committed
QA_TOKEN=

# Private aggregate analytics access; never expose in VITE_ or Pages
ANALYTICS_TOKEN=

# Tianditu browser Key for authorised basemap display (public identifier)
TIANDITU_WEB_KEY=

# Private bulk-cache import credential; never expose to Pages
DATA_ADMIN_TOKEN=
# Optional server-side backup map credentials
TENCENT_WEB_SERVICE_KEY=
BAIDU_WEB_SERVICE_KEY=
# Private SN signing key (only for Baidu server credentials using SN validation)
BAIDU_WEB_SERVICE_SK=
TIANDITU_SERVICE_KEY=

# Operational write-quota pause only; no store-cache expiry (UTC ISO time)
WRITE_PAUSED_UNTIL=
